# Copy to .env and adjust. Used by both docker-compose files in this directory.

# Public hostname the auth server is reachable under.
# Must have a DNS record pointing at this host.
DOMAIN=pbs-sync-auth.example.com

# Email for the Let's Encrypt account (used for expiry notices).
ACME_EMAIL=admin@example.com

# --- Only for the DNS-01 (Cloudflare) setup ---
# Cloudflare API token with permission Zone > DNS > Edit for the zone of $DOMAIN.
# Not needed for the HTTP-01 setup.
CF_DNS_API_TOKEN=your-cloudflare-api-token
