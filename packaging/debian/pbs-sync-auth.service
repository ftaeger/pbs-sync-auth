[Unit]
Description=PBS offsite push (auth + gated sync-job) daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Configuration lives in a conffile so operator edits survive package upgrades.
# The shared secret is referenced by path (PBS_AUTH_SECRET) and read by the
# client itself, so it never enters the process environment.
EnvironmentFile=/etc/pbs-sync-auth/client.conf
ExecStart=/usr/bin/pbs-auth-client
Restart=always
RestartSec=30
# Light hardening. Deliberately no ProtectSystem/ProtectHome: the daemon runs
# `proxmox-backup-manager` as root, which needs to write PBS state.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
